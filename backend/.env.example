# LifePilot Backend — Environment Variables
# Copy this to .env and fill in your values

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_NAME="LifePilot API"
ENVIRONMENT=development           # development | staging | production
DEBUG=true
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
# Use the same PostgreSQL database as your Next.js app during migration.
# SQLAlchemy will auto-correct postgres:// to postgresql+asyncpg://
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifepilot_ai

# Connection pool (defaults are fine for development)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ─────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────
# IMPORTANT: Use a different secret from your Next.js NEXTAUTH_SECRET.
# FastAPI issues its own JWT tokens — they are separate from NextAuth sessions.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=your_jwt_secret_key_here

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─────────────────────────────────────────
# AI / LLM — NVIDIA NIM
# ─────────────────────────────────────────
# Get your API key at: https://build.nvidia.com
# One key works for ALL NIM-hosted models below.
NIM_API_KEY=nvapi-your_nvidia_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Per-use-case model assignments
# Change these to swap models without touching application code.
#
# CHAT   — best quality, NVIDIA fine-tuned for dialogue & reasoning
NIM_MODEL_CHAT=nvidia/llama-3.1-nemotron-70b-instruct
#
# PLANNER — latest Meta Llama, strong at structured multi-step output
NIM_MODEL_PLANNER=meta/llama-3.3-70b-instruct
#
# TASKS  — Mixtral MoE: fast + reliable JSON generation
NIM_MODEL_TASKS=mistralai/mixtral-8x7b-instruct-v0.1
#
# RAG    — context synthesis from retrieved chunks
NIM_MODEL_RAG=meta/llama-3.1-70b-instruct
#
# SUGGESTIONS / ANALYSIS — simple tasks, fast and cheap
NIM_MODEL_SUGGESTIONS=meta/llama-3.1-8b-instruct
NIM_MODEL_ANALYSIS=meta/llama-3.1-8b-instruct

# Embeddings — 1024 dimensions, exact match for existing pgvector schema
NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSIONS=1024

# Generation defaults
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=4096

# ─────────────────────────────────────────
# Google OAuth + Calendar
# ─────────────────────────────────────────
# Same credentials as your Next.js app
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ─────────────────────────────────────────
# GitHub OAuth
# ─────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here


# ─────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_VERIFICATION_EXPIRE_HOURS=24
